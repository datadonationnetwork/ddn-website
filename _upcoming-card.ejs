<div class="next-wrap"><% if (items.length === 0) { %><p class="next-empty">No upcoming symposium has been announced yet. Join the mailing list to hear first.</p><% } %><% for (const item of items) { %><a class="next-card" href="<%- item.path %>"><% if (item.image) { %><span class="next-photo"><img src="<%- item.image %>" alt="<%= item['image-alt'] || '' %>" loading="lazy"><% if (item['image-credit']) { %><span class="photo-credit"><%= item['image-credit'] %></span><% } %></span><% } %><span class="next-body"><span class="next-eyebrow">Next stop<% if (item.date) { %> · <%= item.date %><% } %></span><span class="next-city"><%= item.location %></span><span class="next-host">Host: <%= item.host %></span><span class="next-dates">Dates: <%= item.dates %></span><span class="next-more">Symposium details →</span></span></a><% } %></div>
