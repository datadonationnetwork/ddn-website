<div class="next-wrap"><% if (items.length === 0) { %><p class="next-empty">No upcoming symposium has been announced yet. Join the mailing list to hear first.</p><% } %><% for (const item of items) { const base = item.path.replace(/[^/]*$/, ''); const img = item['image-side'] ? (/^(https?:)?\//.test(item['image-side']) ? item['image-side'] : base + item['image-side']) : item.image; const alt = item['image-side'] ? item['image-side-alt'] : item['image-alt']; const credit = item['image-side'] ? item['image-side-credit'] : item['image-credit']; %><a class="next-card next-card-side" href="<%- item.path %>"><span class="next-body"><span class="next-eyebrow">Next stop<% if (item.date) { %> · <%= item.date %><% } %></span><span class="next-city"><%= item.location %></span><span class="next-host">Host: <%= item.host %></span><span class="next-dates">Dates: <%= item.dates %></span><span class="next-more">Symposium details →</span></span><% if (img) { %><span class="next-photo"><img src="<%- img %>" alt="<%= alt || '' %>" loading="lazy"><% if (credit) { %><span class="photo-credit"><%= credit %></span><% } %></span><% } %></a><% } %></div>
